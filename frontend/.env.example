# Copy to .env.local and adjust. Every variable is optional; the values shown are the defaults.
# Restart `next dev` after changing them (they are inlined at build time).

# --- Backend ---
# Backend origin, no trailing slash. This is the Express gateway in backend/gateway.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
# Websocket origin for live scan results. Defaults to the API origin.
# NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
# Per-request timeout in milliseconds (uploads included).
NEXT_PUBLIC_API_TIMEOUT_MS=30000
# Set to "true" to run without a backend, using canned responses.
NEXT_PUBLIC_API_MOCK=false

# --- Scan uploads ---
# Files sent in one upload request. A bigger set is split into several requests of this size.
NEXT_PUBLIC_UPLOAD_BATCH_SIZE=10
# Safety-net refresh of a running scan, in milliseconds (the websocket normally delivers results).
NEXT_PUBLIC_SCAN_POLL_MS=5000

# --- Video frame extraction ---
# Comma separated choices, in seconds, for "capture a frame every ...".
NEXT_PUBLIC_FRAME_INTERVALS=0.5,1,2,5
NEXT_PUBLIC_DEFAULT_FRAME_INTERVAL=1
# Most frames taken from one video.
NEXT_PUBLIC_MAX_FRAMES=60
# Frames wider than this many pixels are scaled down before upload.
NEXT_PUBLIC_MAX_FRAME_WIDTH=1280
