# --- HTTP ---
PORT=3001
# Comma separated list of browser origins allowed to call the API and open the websocket.
FRONTEND_ORIGIN=http://localhost:3000
# Number of reverse proxies in front of the API (needed for correct rate limiting by IP).
TRUST_PROXY=0

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Matches the 7 day session cookie the frontend sets.
JWT_TTL_HOURS=168
# Comma separated emails of users who may create and edit categories and models.
ADMIN_EMAILS=

# --- Storage ---
SQLITE_PATH=./data/braincize.db
UPLOAD_DIR=./data/uploads
REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672

# --- Jobs ---
# Batches, results, queued messages and uploaded images are all discarded after this long.
JOB_TTL_HOURS=48
MAX_FILES_PER_BATCH=100
MAX_FILE_MB=10
# Tries per image when a prediction service is unreachable or answers 5xx.
JOB_MAX_ATTEMPTS=3

# --- Prediction services ---
# Models live in the database (see `npm run seed:models`). Only these three values are read by that
# seed script, to build the URLs of the two Python scripts; after seeding, edit models through the API.
# brain.py (serves /predictmid and /predictsz). It runs HTTPS with a self-signed cert.
PYTHON_BRAIN_URL=https://127.0.0.1:4000
# braincize.py (serves /predictyolo and /ismri). brain.py hardcodes http://127.0.0.1:8002/ismri,
# so run braincize.py on port 8002 and keep this URL in step with it.
PYTHON_BRAINCIZE_URL=http://127.0.0.1:8002
# Seeded onto https models so the self-signed certificate is accepted.
PYTHON_INSECURE_TLS=true
# Default per-request timeout; a model can override it with its own timeoutMs.
PYTHON_TIMEOUT_MS=120000
# Images sent to prediction services at the same time, per worker (the frontend used 4).
PYTHON_CONCURRENCY=4
